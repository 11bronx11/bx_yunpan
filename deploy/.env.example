APP_ENV=development
LOG_LEVEL=info
APP_IMAGE_TAG=local
DOCKER_REGISTRY=docker.io
GO_VERSION=1.25.13
UBUNTU_VERSION=24.04
UBUNTU_MIRROR=http://mirrors.aliyun.com/ubuntu-ports/
PARSER_PYTHON_INDEX=https://mirrors.aliyun.com/pypi/simple
GO_PROXY=https://proxy.golang.org,direct
PARSER_GO_PROXY=https://goproxy.cn,direct
GO_BUILD_PARALLELISM=1
GO_BUILD_MAX_PROCS=2
COMPOSE_PARALLEL_LIMIT=1
BUILD_MEMORY_LIMIT=1536m
BUILD_MEMORY_SWAP_LIMIT=2048m
BUILD_CPU_PERIOD=100000
BUILD_CPU_QUOTA=100000
BUILD_MIN_AVAILABLE_MB=1536
YUNPAN_MIN_FREE_GB=6
YUNPAN_UP_ATTEMPTS=3
NODE_VERSION=22.23.0

APP_BIND_IP=127.0.0.1
INFRA_BIND_IP=127.0.0.1
WEB_PORT=3000
API_PORT=8081

HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=65536
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_PROBE_TIMEOUT=2s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s

POSTGRES_DB=yunpan
POSTGRES_USER=yunpan
POSTGRES_PASSWORD=yunpan
POSTGRES_PORT=5432
# Optional HA writer endpoint. Unset keeps the bundled PostgreSQL service.
POSTGRES_PRIMARY_DSN=
# Compatibility alias; new deployments should set POSTGRES_PRIMARY_DSN.
POSTGRES_DSN=
POSTGRES_MAX_OPEN_CONNS=32
POSTGRES_MAX_IDLE_CONNS=8
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m

REDIS_PASSWORD=
REDIS_DB=0
# Optional role isolation; unset values inherit REDIS_ADDR/PASSWORD/DB.
REDIS_COORDINATION_ADDR=
REDIS_COORDINATION_PASSWORD=
REDIS_COORDINATION_DB=
REDIS_CACHE_ADDR=
REDIS_CACHE_PASSWORD=
REDIS_CACHE_DB=
REDIS_PORT=6379

# Derived caches can be disabled without changing business reads or writes.
CACHE_ENABLED=true
CACHE_TTL=5m
CACHE_L1_MAX_ITEMS=512

MINIO_ROOT_USER=yunpan
MINIO_ROOT_PASSWORD=yunpan-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=yunpan
S3_REGION=us-east-1
S3_SECURE=false
S3_PUBLIC_ENDPOINT=127.0.0.1:3000
S3_PUBLIC_PATH_PREFIX=/storage
S3_PUBLIC_SECURE=false
S3_READ_URL_TTL=10m

AUTH_ISSUER=bx-yunpan
AUTH_SIGNING_SEED=bx-yunpan-development-signing-seed
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
SHARE_SECRET=bx-yunpan-development-share-secret
SHARE_ACCESS_TTL=15m
USER_DEFAULT_QUOTA_BYTES=10737418240

UPLOAD_SESSION_TTL=24h
UPLOAD_PART_URL_TTL=15m
UPLOAD_CLEANUP_INTERVAL=5m
UPLOAD_CLEANUP_BATCH=100

WORKER_CONCURRENCY=8
WORKER_METRICS_ADDR=:8083
WORKER_QUEUE_AI=4
WORKER_QUEUE_MEDIA=4
WORKER_QUEUE_OBJECT=2
WORKER_QUEUE_MAINTENANCE=1
# Set via ./deploy/up.sh --distributed-workers to use independent P2 roles.
WORKER_MODE=combined

# LISTEN/NOTIFY wakes new work quickly; bounded adaptive scans recover missed signals.
# Minimum scan/error/follower retry interval; idle scans back off to the maximum below.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_POLL_MAX_INTERVAL=30s
# Per-operation database deadline. RabbitMQ publishes use RABBITMQ_PUBLISH_TIMEOUT.
OUTBOX_SCAN_TIMEOUT=10s
# Each dispatcher replica holds one dedicated PostgreSQL connection when enabled.
OUTBOX_NOTIFY_ENABLED=true
# Rows claimed at once; RabbitMQ publishes are sequential and stop on first failure.
OUTBOX_BATCH_SIZE=20
OUTBOX_TASK_MAX_RETRY=8
OUTBOX_TASK_TIMEOUT=30m
# Keep disabled until the delivery-aware relay and all compatible workers are deployed.
OUTBOX_V2_EVENTS_ENABLED=false
SEARCH_INDEX_ENABLED=false
SEARCH_WRITE_BACKENDS=postgres
SEARCH_READ_BACKEND=postgres
SEARCH_SHADOW_SAMPLE_RATE=0
SEARCH_INDEX_EPOCH=v1
SEARCH_ES_ENDPOINT=
SEARCH_ES_USERNAME=
SEARCH_ES_PASSWORD=
SEARCH_QDRANT_ENDPOINT=
SEARCH_QDRANT_API_KEY=
SEARCH_EXTERNAL_TIMEOUT=2s
SEARCH_EXTERNAL_WRITE_TIMEOUT=10s
SEARCH_INDEX_BATCH_SIZE=100
SEARCH_VECTOR_OVERSAMPLE=4
SEARCH_EXTERNAL_FALLBACK=true
OBJECT_GC_DELAY=24h

# true starts aisvc and enables AI routes/indexing; false is reserved for the no-AI template.
AI_ENABLED=true
# Use fake for an offline demo. dashscope requires DASHSCOPE_API_KEY.
AI_PROVIDER=fake
DASHSCOPE_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v4
AI_VISION_MODEL=qwen-vl-plus
# Reranker is Ask-only and opt-in; fake provider uses a deterministic local implementation.
AI_RERANK_ENABLED=false
# DashScope qwen3-rerank uses the compatible-api root; do not append /reranks.
# Public: https://dashscope.aliyuncs.com/compatible-api/v1
# Workspace: https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-api/v1
AI_RERANK_BASE_URL=
AI_RERANK_MODEL=qwen3-rerank
AI_RERANK_CANDIDATES=30
AI_RERANK_TOP_K=8
AI_RERANK_TIMEOUT=30s
# The database migration stores vector(1024); keep this value unchanged.
AI_EMBEDDING_DIMENSION=1024
AI_MAX_OBJECT_MIB=32
AI_REQUEST_TIMEOUT=90s
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_SEARCH_PER_MINUTE=30
AI_RATE_LIMIT_ASK_PER_MINUTE=10
AI_RATE_LIMIT_REPROCESS_PER_MINUTE=3

# aisvc 的 gRPC 监听地址与 API 侧 dial 目标。
AISVC_REPLICAS=1
AISVC_GRPC_ADDR=:8082
AISVC_GRPC_TARGET=aisvc:8082
AI_SERVICE_ROLE=combined
# 单次调用总预算，不得短于 AI_REQUEST_TIMEOUT（三层 deadline 收敛）。
AISVC_CALL_TIMEOUT=120s
AISVC_SEARCH_MAX_ATTEMPTS=3
AISVC_REPROCESS_MAX_ATTEMPTS=3
AISVC_RETRY_BASE_BACKOFF=20ms
AISVC_RETRY_MAX_BACKOFF=1s
AISVC_BREAKER_WINDOW=10s
AISVC_BREAKER_MIN_REQUESTS=20
AISVC_BREAKER_FAILURE_RATE=0.5
AISVC_BREAKER_OPEN_TIMEOUT=5s
AISVC_BREAKER_HALF_OPEN_PROBES=3

# Parser runs as a separate gRPC process and registers under its own etcd prefix.
PARSER_REMOTE_ENABLED=true
PARSER_REPLICAS=1
PARSER_GRPC_ADDR=:8084
PARSER_GRPC_TARGET=parser-svc:8084
PARSER_ETCD_SERVICE_PREFIX=/services/document-parser
PARSER_ADVERTISE_ADDR=
PARSER_CALL_TIMEOUT=90s
PARSER_MAX_CONCURRENT=2
PARSER_ENGINE_ADDR=127.0.0.1:8090
PARSER_WORKER_DIR=/app/parser_worker
PARSER_PROFILE_VERSION=light-parser-v1
PARSER_MEMORY_LIMIT=1g
PARSER_CPUS=2
PARSER_CHUNK_TOKEN_BUDGET=600
PARSER_CHUNK_OVERLAP_TOKENS=60
PARSER_MAX_CHUNKS=256
PARSER_CHUNKER_VERSION=document-chunker-v1
PARSER_TOKENIZER_ID=mixed-script-estimate-v1

# 链路追踪。开启前先起 observability profile（otel-collector + jaeger）。
# 生产环境按流量把采样率调到 0.01~0.1；ParentBased 保证一条 trace 全采或全不采。
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_TRACES_SAMPLER_ARG=1.0

# 服务注册发现。关闭时 API 直连 AISVC_GRPC_TARGET，多副本无法自动发现。
ETCD_ENABLED=true
ETCD_IMAGE=quay.io/coreos/etcd:v3.6.6
ETCD_ENDPOINTS=etcd:2379
ETCD_USERNAME=
ETCD_PASSWORD=
ETCD_DIAL_TIMEOUT=5s
ETCD_SERVICE_PREFIX=/services/aisvc
# 租约时长：实例进程消失后最多这么久被摘除。心跳间隔是 TTL/3。
ETCD_LEASE_TTL=10s
# 留空则用容器 hostname + 监听端口，--scale 时每个副本自动注册自己的地址。
AISVC_ADVERTISE_ADDR=

# Outbox dispatcher 多副本选主，避免同一批 outbox 行被重复投递。
# TTL 必须长于两倍 OUTBOX_POLL_INTERVAL，否则主从会在临界点上来回抖动。
OUTBOX_LEADER_LOCK_ENABLED=true
OUTBOX_LEADER_LOCK_KEY=yunpan:outbox:dispatcher:leader
OUTBOX_LEADER_LOCK_TTL=15s

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686

# RabbitMQ is the durable task broker; Redis is for cache/coordination.
RABBITMQ_USER=yunpan
RABBITMQ_PASSWORD=yunpan-dev-secret
RABBITMQ_URL=
RABBITMQ_EXCHANGE=yunpan.tasks
RABBITMQ_PREFETCH=16
RABBITMQ_PUBLISH_TIMEOUT=5s
TASK_CANCEL_GRACE=10s
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
