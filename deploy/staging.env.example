# Local staging only. Always pass this file explicitly with --env-file.
APP_ENV=staging
APP_IMAGE_TAG=hc-staging
POSTGRES_USER=hc_staging
POSTGRES_PASSWORD=hc-staging-local-only
POSTGRES_DB=hc_staging
POSTGRES_PORT=25432
REDIS_PORT=26379
MINIO_PORT=29000
MINIO_CONSOLE_PORT=29001
WEB_PORT=3002
APP_BIND_IP=127.0.0.1
INFRA_BIND_IP=127.0.0.1
MINIO_ROOT_USER=hc-staging
MINIO_ROOT_PASSWORD=hc-staging-local-only
S3_BUCKET=hc-staging
S3_PUBLIC_ENDPOINT=127.0.0.1:3002
AUTH_SIGNING_SEED=hc-staging-local-signing-seed
SHARE_SECRET=hc-staging-local-share-secret
AI_ENABLED=true
AI_PROVIDER=fake
AISVC_GRPC_TARGET=ai-query:8082
PARSER_REMOTE_ENABLED=true
PARSER_PROFILE_VERSION=light-parser-v1
PARSER_REPLICAS=1
PARSER_GRPC_TARGET=parser-svc:8084
ETCD_ENABLED=true
REDIS_COORDINATION_ADDR=redis-coordination:6379
REDIS_CACHE_ADDR=redis-cache:6379
OUTBOX_V2_EVENTS_ENABLED=true
SEARCH_INDEX_ENABLED=true
SEARCH_WRITE_BACKENDS=postgres
SEARCH_READ_BACKEND=postgres
GO_BUILD_PARALLELISM=1
GO_BUILD_MAX_PROCS=2
