# Core-only Docker Compose configuration. Generate deploy/.env with:
#   ./deploy/init-env.sh --no-ai

APP_ENV=development
LOG_LEVEL=info
APP_IMAGE_TAG=local
DOCKER_REGISTRY=docker.io
GO_VERSION=1.25.13
UBUNTU_VERSION=24.04
UBUNTU_MIRROR=http://mirrors.aliyun.com/ubuntu-ports/
PARSER_PYTHON_INDEX=https://mirrors.aliyun.com/pypi/simple
GO_PROXY=https://proxy.golang.org,direct
PARSER_GO_PROXY=https://goproxy.cn,direct
GO_BUILD_PARALLELISM=1
GO_BUILD_MAX_PROCS=2
COMPOSE_PARALLEL_LIMIT=1
BUILD_MEMORY_LIMIT=1536m
BUILD_MEMORY_SWAP_LIMIT=2048m
BUILD_CPU_PERIOD=100000
BUILD_CPU_QUOTA=100000
BUILD_MIN_AVAILABLE_MB=1536
YUNPAN_MIN_FREE_GB=6
YUNPAN_UP_ATTEMPTS=3
NODE_VERSION=22.23.0

APP_BIND_IP=127.0.0.1
INFRA_BIND_IP=127.0.0.1
WEB_PORT=3000
API_PORT=8081

HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=65536
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_PROBE_TIMEOUT=2s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s

POSTGRES_DB=yunpan
POSTGRES_USER=yunpan
POSTGRES_PASSWORD=yunpan
POSTGRES_PORT=5432
# Optional HA writer endpoint. Unset keeps the bundled PostgreSQL service.
POSTGRES_PRIMARY_DSN=
# Compatibility alias; new deployments should set POSTGRES_PRIMARY_DSN.
POSTGRES_DSN=
POSTGRES_MAX_OPEN_CONNS=32
POSTGRES_MAX_IDLE_CONNS=8
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m

REDIS_PASSWORD=
REDIS_DB=0
# Optional role isolation; unset values inherit REDIS_ADDR/PASSWORD/DB.
REDIS_COORDINATION_ADDR=
REDIS_COORDINATION_PASSWORD=
REDIS_COORDINATION_DB=
REDIS_CACHE_ADDR=
REDIS_CACHE_PASSWORD=
REDIS_CACHE_DB=
REDIS_PORT=6379

CACHE_ENABLED=true
CACHE_TTL=5m
CACHE_L1_MAX_ITEMS=512

MINIO_ROOT_USER=yunpan
MINIO_ROOT_PASSWORD=yunpan-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=yunpan
S3_REGION=us-east-1
S3_SECURE=false
S3_PUBLIC_ENDPOINT=127.0.0.1:3000
S3_PUBLIC_PATH_PREFIX=/storage
S3_PUBLIC_SECURE=false
S3_READ_URL_TTL=10m

AUTH_ISSUER=bx-yunpan
AUTH_SIGNING_SEED=bx-yunpan-development-signing-seed
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
SHARE_SECRET=bx-yunpan-development-share-secret
SHARE_ACCESS_TTL=15m
USER_DEFAULT_QUOTA_BYTES=10737418240

UPLOAD_SESSION_TTL=24h
UPLOAD_PART_URL_TTL=15m
UPLOAD_CLEANUP_INTERVAL=5m
UPLOAD_CLEANUP_BATCH=100

WORKER_CONCURRENCY=8
WORKER_METRICS_ADDR=:8083
WORKER_QUEUE_AI=4
WORKER_QUEUE_MEDIA=4
WORKER_QUEUE_OBJECT=2
WORKER_QUEUE_MAINTENANCE=1
WORKER_QUEUE_UPLOAD=2
# Legacy setting retained for compatibility; explicit roles are now the default.
WORKER_MODE=combined

# Legacy dispatcher settings retained for import/compatibility. New control uses ASYNC_*.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_POLL_MAX_INTERVAL=30s
OUTBOX_SCAN_TIMEOUT=10s
OUTBOX_NOTIFY_ENABLED=true
OUTBOX_BATCH_SIZE=20
OUTBOX_TASK_MAX_RETRY=8
OUTBOX_TASK_TIMEOUT=30m
# Compatibility value only; fact events are always appended by the new outbox.
OUTBOX_V2_EVENTS_ENABLED=false
SEARCH_INDEX_ENABLED=false
SEARCH_WRITE_BACKENDS=postgres
SEARCH_READ_BACKEND=postgres
SEARCH_SHADOW_SAMPLE_RATE=0
SEARCH_INDEX_EPOCH=v1
SEARCH_ES_ENDPOINT=
SEARCH_ES_USERNAME=
SEARCH_ES_PASSWORD=
SEARCH_QDRANT_ENDPOINT=
SEARCH_QDRANT_API_KEY=
SEARCH_EXTERNAL_TIMEOUT=2s
SEARCH_EXTERNAL_WRITE_TIMEOUT=10s
SEARCH_INDEX_BATCH_SIZE=100
SEARCH_VECTOR_OVERSAMPLE=4
SEARCH_EXTERNAL_FALLBACK=true
OBJECT_GC_DELAY=24h

# Core-only mode: aisvc is not built or started, and new uploads do not enqueue AI work.
AI_ENABLED=false
AI_PROVIDER=disabled
DASHSCOPE_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v4
AI_VISION_MODEL=qwen3-vl-plus
AI_RERANK_ENABLED=false
# DashScope qwen3-rerank compatible-api root; do not append /reranks.
# Public: https://dashscope.aliyuncs.com/compatible-api/v1
# Workspace: https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-api/v1
AI_RERANK_BASE_URL=
AI_RERANK_MODEL=qwen3-rerank
AI_RERANK_CANDIDATES=30
AI_RERANK_TOP_K=8
AI_RERANK_TIMEOUT=30s
AI_EMBEDDING_DIMENSION=1024
AI_MAX_OBJECT_MIB=32
AI_REQUEST_TIMEOUT=90s
AI_RATE_LIMIT_ENABLED=false
AI_RATE_LIMIT_SEARCH_PER_MINUTE=30
AI_RATE_LIMIT_ASK_PER_MINUTE=10
AI_RATE_LIMIT_REPROCESS_PER_MINUTE=3

# Retained for schema alignment and easy re-enablement; ignored while AI_ENABLED=false.
AISVC_REPLICAS=0
AISVC_GRPC_ADDR=:8082
AISVC_GRPC_TARGET=aisvc:8082
AI_SERVICE_ROLE=combined
AISVC_CALL_TIMEOUT=120s
AISVC_SEARCH_MAX_ATTEMPTS=3
AISVC_REPROCESS_MAX_ATTEMPTS=3
AISVC_RETRY_BASE_BACKOFF=20ms
AISVC_RETRY_MAX_BACKOFF=1s
AISVC_BREAKER_WINDOW=10s
AISVC_BREAKER_MIN_REQUESTS=20
AISVC_BREAKER_FAILURE_RATE=0.5
AISVC_BREAKER_OPEN_TIMEOUT=5s
AISVC_BREAKER_HALF_OPEN_PROBES=3

# Parser service is disabled with the AI feature set.
PARSER_REMOTE_ENABLED=false
PARSER_REPLICAS=0
PARSER_GRPC_ADDR=:8084
PARSER_GRPC_TARGET=parser-svc:8084
PARSER_ETCD_SERVICE_PREFIX=/services/document-parser
PARSER_ADVERTISE_ADDR=
PARSER_CALL_TIMEOUT=90s
PARSER_MAX_CONCURRENT=2
PARSER_ENGINE_ADDR=127.0.0.1:8090
PARSER_WORKER_DIR=/app/parser_worker
PARSER_PROFILE_VERSION=light-parser-v1
PARSER_MEMORY_LIMIT=1g
PARSER_CPUS=2
PARSER_CHUNK_TOKEN_BUDGET=600
PARSER_CHUNK_OVERLAP_TOKENS=60
PARSER_MAX_CHUNKS=256
PARSER_CHUNKER_VERSION=document-chunker-v3
PARSER_TOKENIZER_ID=mixed-script-estimate-v1

OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_TRACES_SAMPLER_ARG=1.0

# etcd is only used for aisvc discovery in this project.
ETCD_ENABLED=false
ETCD_IMAGE=quay.io/coreos/etcd:v3.6.6
ETCD_ENDPOINTS=etcd:2379
ETCD_USERNAME=
ETCD_PASSWORD=
ETCD_DIAL_TIMEOUT=5s
ETCD_SERVICE_PREFIX=/services/aisvc
ETCD_LEASE_TTL=10s
AISVC_ADVERTISE_ADDR=

# 旧 dispatcher 兼容配置；新控制模块在独立控制 PG 中持有租约。
OUTBOX_LEADER_LOCK_ENABLED=true
OUTBOX_LEADER_LOCK_KEY=yunpan:outbox:dispatcher:leader
OUTBOX_LEADER_LOCK_TTL=15s

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686

# RabbitMQ is the durable task broker; Redis is for cache/coordination.
RABBITMQ_USER=yunpan
RABBITMQ_PASSWORD=yunpan-dev-secret
RABBITMQ_URL=
RABBITMQ_EXCHANGE=yunpan.tasks
RABBITMQ_PREFETCH=16
RABBITMQ_PUBLISH_TIMEOUT=5s
TASK_CANCEL_GRACE=10s
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Independent async control database and bounded execution/commit budgets.
POSTGRES_READONLY_DSN=
POSTGRES_READER_USER=yunpan_async_reader
POSTGRES_READER_PASSWORD=
ASYNC_CONTROL_DSN=
ASYNC_POSTGRES_USER=yunpan_control
ASYNC_POSTGRES_PASSWORD=
ASYNC_POSTGRES_DB=yunpan_control
ASYNC_POSTGRES_PORT=5433
ASYNC_CONTROL_MAX_OPEN_CONNS=8
ASYNC_CONTROL_MAX_IDLE_CONNS=2
ASYNC_CONTROL_CRITICAL_CONNS=2
ASYNC_RELAY_ROWS=200
ASYNC_RELAY_BYTES=1048576
ASYNC_POLL_MIN=100ms
ASYNC_POLL_MAX=2s
ASYNC_LEASE=30s
ASYNC_WORKER_CONCURRENCY=2
ASYNC_GC_SCAN_INTERVAL=5m
ASYNC_GC_SCAN_BATCH=100
ASYNC_RETRY_BASE=5s
ASYNC_RETRY_CAP=5m
ASYNC_COMMIT_WINDOW=24h
ASYNC_OUTPUT_SAFETY=1h
ASYNC_DETAIL_RETENTION=168h

ASYNC_MAX_ATTEMPTS=12
ASYNC_MAX_DISPATCHES=20
ASYNC_TASK_LIFETIME=24h
ASYNC_STAGING_DAYS=14

MINIO_API_STALE_UPLOADS_EXPIRY=336h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=1h
# v3 激活需成组设置：3 / bx.async.v3 / 原 v2 前缀；先完成保留数据交接。
ASYNC_PROTOCOL_VERSION=2
ASYNC_BROKER_PREFIX=bx.async.v2
ASYNC_LEGACY_BROKER_PREFIX=bx.async.v1

# Independent AI content database and service identities (init-env fills missing secrets).
AI_POSTGRES_USER=yunpan_ai
AI_POSTGRES_PASSWORD=
AI_POSTGRES_DB=yunpan_ai
AI_POSTGRES_PORT=5434
AI_QUERY_PASSWORD=
AI_COMPUTE_PASSWORD=
AI_COMMIT_PASSWORD=
AI_QUERY_DSN=
AI_COMPUTE_DSN=
AI_COMMIT_DSN=
AI_MIGRATION_DSN=
CORE_INTERNAL_GRPC_ADDR=:51053
CORE_INTERNAL_ADVERTISE_ADDR=core-internal:51053
CORE_INTERNAL_TARGET=core-internal:51053
AI_QUERY_GRPC_ADDR=:51054
AI_QUERY_ADVERTISE_ADDR=ai-query:51054
AI_QUERY_TARGET=ai-query:51054
CORE_INTERNAL_SERVICE_TOKEN=
AI_QUERY_SERVICE_TOKEN=
PARSER_SERVICE_TOKEN=
AI_SCOPE_SIGNING_SEED=
AI_SCOPE_PUBLIC_KEY=
AI_PROCESSING_SIGNING_SEED=
AI_PROCESSING_PUBLIC_KEY=
AI_PROFILE_ID=default
AI_PROFILE_REVISION=v1
AI_EMBEDDING_REVISION=config-v1
AI_SUMMARY_REVISION=config-v1
AI_SUMMARY_PROMPT_VERSION=overview-v1
AI_VECTORS_ENABLED=true
AI_SUMMARY_ENABLED=true
AI_QUERY_TIMEOUT=10s
AI_ASK_TIMEOUT=60s
CORE_INTERNAL_TIMEOUT=5s
AI_SCOPE_MAX_FILES=10000
AI_SUMMARY_MAX_CALLS=128
AI_CONTROL_MIGRATION_DSN=
AI_INTENT_MIGRATION_DSN=
AI_LEGACY_WRITERS_STOPPED=false

# Optional internal mutual TLS. Mount these certificate paths into every RPC role.
INTERNAL_GRPC_TLS_CA=
INTERNAL_GRPC_TLS_CERT=
INTERNAL_GRPC_TLS_KEY=
INTERNAL_GRPC_TLS_SERVER_NAME=

# Independent projection generations; advance only the rebuilt backend.
AI_PROJECTION_NAMESPACE=bx-ai
AI_TEXT_INDEX_EPOCH=v1
AI_VECTOR_INDEX_EPOCH=v1

AI_ASK_ENABLED=true

# Only for the resumable v1 to v2 handover tool.
